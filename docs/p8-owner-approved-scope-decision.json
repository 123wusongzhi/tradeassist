  "acceptanceCriteria": [
    "AC-01: Operation tasks can be created with tenant boundary and audit event",
    "AC-02: Illegal state transitions are rejected with stable error codes",
    "AC-03: Only reviewer or admin can approve or reject",
    "AC-04: Approved draft version and executed draft hash must match",
    "AC-05: Unapproved tasks cannot execute",
    "AC-06: No automatic publish or automatic listing path exists",
    "AC-07: Douyin uses mock or sandbox; other platforms use local_draft_only",
    "AC-08: Duplicate execution requests do not create duplicate attempts or drafts",
    "AC-09: Failure records include category, retryability, count, and audit",
    "AC-10: Viewer/operator/reviewer/admin boundaries are tested",
    "AC-11: Admin can review, edit, approve, reject, execute, and retry",
    "AC-12: Every state transition is visible in audit timeline",
    "AC-13: Logs and evidence contain no real secrets",
