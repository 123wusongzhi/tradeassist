# =============================================================================
# TradeMind 环境变量 — development 可选叠加项
# =============================================================================
#
# 【本文件用途】
#   仅列出 development 与「通用 .env.example」不同的开关，不是完整配置。
#   适合团队统一本地调试行为（开 Demo Seed、Swagger、Dev 路由等）。
#
# 【如何使用】
#   方式 A（推荐）：直接改根目录 `.env`（从 .env.example 复制而来），不必再用本文件。
#   方式 B：复制为 `.env.development` 或 `.env.development.local`（gitignore），
#           在已有 `.env` 基础上由后端叠加加载（仅 APP_ENV=development 时）。
#
# 【不要用于】staging / production — 那些环境请用 .env.staging.example / .env.production.example
# =============================================================================

APP_ENV=development
APP_HTTP_ADDR=:8080
JWT_SECRET=change-me-in-development

ENABLE_DEMO_SEED=true
ENABLE_DEV_ROUTES=true
ENABLE_SWAGGER=true
ENABLE_DEBUG_ENDPOINTS=true
LOG_LEVEL=debug
