# =============================================================================
# TradeMind 环境变量 — Staging 预发环境
# =============================================================================
#
# 【本文件用途】
#   预发/准生产：HTTPS 公网 Admin/API 地址、对象存储（非 local）、关闭全部危险调试功能。
#   用于验证 Nginx、TLS、Storage 公网访问后再上 production。
#
# 【如何使用】
#   复制为服务器 env 文件，例如：
#     sudo cp .env.staging.example /etc/trademind/trademind.env
#     sudo chmod 600 /etc/trademind/trademind.env
#   设置 APP_ENV=staging，并填写 APP_MASTER_KEY、JWT_SECRET、DB 密码等。
#   Storage 凭证在管理端「存储设置」写入（settings.storage），不要写进本文件。
#
# 【不要用于】本地日常开发 — 请用 .env.example → .env
# =============================================================================

APP_ENV=staging
APP_HTTP_ADDR=:8080
ADMIN_PUBLIC_URL=https://staging-admin.example.com
API_PUBLIC_URL=https://staging-api.example.com

APP_MASTER_KEY=
JWT_SECRET=

DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=trademind
DB_PASSWORD=
DB_NAME=trademind_staging

REDIS_ADDR=127.0.0.1:6379

LOG_LEVEL=info
ENABLE_SWAGGER=false
ENABLE_DEV_ROUTES=false
ENABLE_DEMO_SEED=false
ENABLE_DEBUG_ENDPOINTS=false
