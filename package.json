{
  "name": "trademind-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "rc-resize-observer": "1.4.3",
      "react": "18.2.0",
      "react-dom": "18.2.0"
    }
  },
  "scripts": {
    "dev": "tsx scripts/dev-all.ts",
    "check:ui-copy": "node scripts/check-ui-copy.mjs",
    "check:dev": "tsx scripts/check-dev-env.ts",
    "demo:auto-acceptance": "powershell -ExecutionPolicy Bypass -File scripts/demo-auto-acceptance.ps1",
    "seed:demo-data": "powershell -ExecutionPolicy Bypass -File scripts/seed-demo-data.ps1",
    "seed:demo-permissions": "powershell -ExecutionPolicy Bypass -File scripts/seed-demo-permissions.ps1",
    "verify:demo-data": "node scripts/verify-demo-data.mjs",
    "verify:demo-permissions": "node scripts/verify-demo-permissions.mjs",
    "check:p4-r": "node scripts/p4-r-demo-regression-closure-check.mjs",
    "check:p6": "node scripts/p6-backup-release-dr-check.mjs",
    "drill:p6-v:restore": "node scripts/p6-v-isolated-restore-drill.mjs",
    "drill:p6-v:release": "node scripts/p6-v-release-rollback-drill.mjs",
    "check:p6-v:race": "node scripts/p6-v-linux-race.mjs",
    "check:p6-v": "node scripts/p6-v-final-closure-gate.mjs",
    "p7:dataset": "node scripts/p7-generate-dataset.mjs",
    "p7-v:env:start": "node scripts/p7-v-start-performance-env.mjs",
    "p7-v:env:stop": "node scripts/p7-v-stop-performance-env.mjs",
    "p7-v:audit": "node scripts/p7-v-capability-audit.mjs",
    "p7-v:load": "node scripts/p7-v-run-load-tests.mjs",
    "p7-v:soak": "node scripts/p7-v-run-soak-test.mjs",
    "p7-v:race": "node scripts/p7-v-linux-race.mjs",
    "check:p7-v": "node scripts/p7-v-final-closure-gate.mjs",
    "check:p7": "node scripts/p7-performance-capacity-check.mjs",
    "check:p7:regression": "node scripts/p7-performance-regression-gate.mjs",
    "postinstall": "node scripts/patch-pro-field-antd-select.mjs",
    "dev:infra": "docker compose up -d postgres redis",
    "dev:backend": "tsx scripts/dev-backend.ts",
    "dev:stop": "docker compose stop",
    "dev:reset": "tsx scripts/dev-reset.ts",
    "dev:admin": "pnpm --filter @trademind/admin dev",
    "build:admin": "pnpm --filter @trademind/admin build",
    "preview:admin": "pnpm --filter @trademind/admin preview",
    "dev:collector": "pnpm --filter @trademind/collector dev",
    "collect:test": "pnpm --filter @trademind/collector collect:test",
    "build:collector": "pnpm --filter @trademind/collector build",
    "install:collector:browsers": "pnpm --filter @trademind/collector exec playwright install chromium"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "execa": "^9.5.2",
    "picocolors": "^1.1.1",
    "tsx": "^4.19.2"
  }
}
