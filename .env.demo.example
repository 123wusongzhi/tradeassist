# =============================================================================
# TradeMind 环境变量 — Demo 演示环境
# =============================================================================
#
# 【本文件用途】
#   对内/对外 Demo 主机：允许 Demo 数据种子，仍可使用 local Storage，但不开放 Swagger / Dev 调试路由。
#
# 【如何使用】
#   复制为服务器上的 env 文件（如 `/etc/trademind/trademind.env`），或本地 `.env` 并设 APP_ENV=demo。
#   填入真实 DB/Redis 密码；勿提交含密钥的文件。
#
# 【与 .env.example 区别】
#   APP_ENV=demo；ENABLE_DEMO_SEED=true；ENABLE_DEV_ROUTES/SWAGGER=false。
# =============================================================================

APP_ENV=demo
APP_HTTP_ADDR=:8080
JWT_SECRET=change-me-in-production

DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=trademind
DB_PASSWORD=trademind
DB_NAME=trademind

REDIS_ADDR=127.0.0.1:6379

ENABLE_DEMO_SEED=true
ENABLE_DEV_ROUTES=false
ENABLE_SWAGGER=false
ENABLE_DEBUG_ENDPOINTS=false
