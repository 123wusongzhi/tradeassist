# =============================================================================
# TradeMind isolated automated test environment template
# =============================================================================
# Copy to your shell/CI secrets as needed. Do not create or commit .env.test.
# Every database/Redis target below is intentionally named with test/e2e markers.

APP_ENV=test
APP_NAME=TradeMind Test
APP_HTTP_ADDR=:8081
LOG_LEVEL=warn

# PostgreSQL integration tests. Database name must contain test, _test, or e2e.
TEST_DATABASE_URL=postgres://trademind:trademind@127.0.0.1:5432/trademind_test?sslmode=disable
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=trademind
DB_PASSWORD=trademind
DB_NAME=trademind_test
DB_TIMEZONE=UTC

# Redis integration tests. Use a non-zero isolated DB or disposable service container.
TEST_REDIS_URL=redis://127.0.0.1:6379/15
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=15

# Disable real third-party writes in automated tests.
EXTERNAL_PROVIDER_MODE=fake
DOUYIN_WRITE_ENABLED=false
AUTO_LISTING_ENABLED=false
ENABLE_DEV_ROUTES=false
ENABLE_DEMO_SEED=false
ENABLE_DEBUG_ENDPOINTS=false
WEBHOOK_ENABLE_TEST_VERIFIER=true

# Collector tests must not use real platform credentials.
COLLECTOR_HTTP_ADDR=:3101
COLLECTOR_MAIN_SERVICE_URL=http://127.0.0.1:8081
COLLECTOR_GOTO_TIMEOUT_MS=5000
COLLECTOR_HEADLESS=1
