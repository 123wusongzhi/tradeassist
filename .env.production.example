# =============================================================================
# TradeMind 环境变量 — Production 生产环境
# =============================================================================
#
# 【本文件用途】
#   生产部署必填项清单。缺失弱密钥或启用 Demo Seed / Dev 路由时，API 将 fail-fast 拒绝启动。
#
# 【如何使用】
#   sudo cp .env.production.example /etc/trademind/trademind.env
#   sudo chmod 600 /etc/trademind/trademind.env
#   编辑填入强随机 JWT_SECRET、APP_MASTER_KEY、DB/Redis 密码、真实公网 URL。
#   systemd 通过 EnvironmentFile 加载；或设置 APP_ENV_FILE 指向该路径。
#   切勿将含真实密钥的文件提交 Git。
#
# 【Storage】kind 须在管理端设为 cos/oss/s3 等；public_base 须 HTTPS 公网可访问。
# 部署模板：deploy/nginx/ · deploy/systemd/ · docs/PRODUCTION_DOMAIN_HTTPS_GUIDE.md
# =============================================================================

APP_ENV=production
APP_NAME=TradeMind
APP_VERSION=
APP_HTTP_ADDR=:8080
ADMIN_PUBLIC_URL=https://admin.example.com
API_PUBLIC_URL=https://api.example.com

APP_MASTER_KEY=
JWT_SECRET=
JWT_EXPIRE_HOURS=168

ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=

DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=trademind
DB_PASSWORD=
DB_NAME=trademind
DB_TIMEZONE=UTC

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

LOG_LEVEL=info
UPLOAD_MAX_MB=10

ENABLE_SWAGGER=false
ENABLE_DEV_ROUTES=false
ENABLE_DEMO_SEED=false
ENABLE_DEBUG_ENDPOINTS=false

COLLECTOR_BASE_URL=http://127.0.0.1:3100
COLLECT_QUEUE_ENABLED=true
IMAGE_QUEUE_ENABLED=true
ORDER_SYNC_QUEUE_ENABLED=true
CUSTOMER_MESSAGE_SYNC_QUEUE_ENABLED=true
PRODUCT_PUBLISH_QUEUE_ENABLED=true
INVENTORY_SYNC_QUEUE_ENABLED=true

# Storage credentials: configure in Admin → 存储设置 (settings.storage), not here.
