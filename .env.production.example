# =============================================================================
# TradeMind 环境变量 — Production 生产环境
# =============================================================================
#
# 【本文件用途】
#   生产部署必填项清单。缺失弱密钥或启用 Demo Seed / Dev 路由时，API 将 fail-fast 拒绝启动。
#
# 【如何使用】
#   sudo cp .env.production.example /etc/trademind/trademind.env
#   sudo chmod 600 /etc/trademind/trademind.env
#   编辑填入强随机 JWT_SECRET、APP_MASTER_KEY、DB/Redis 密码、真实公网 URL。
#   systemd 通过 EnvironmentFile 加载；或设置 APP_ENV_FILE 指向该路径。
#   切勿将含真实密钥的文件提交 Git。
#
# 【Storage】kind 须在管理端设为 cos/oss/s3 等；public_base 须 HTTPS 公网可访问。
# 部署模板：deploy/nginx/ · deploy/systemd/ · docs/PRODUCTION_DOMAIN_HTTPS_GUIDE.md
# =============================================================================

APP_ENV=production
APP_NAME=TradeMind
APP_VERSION=
APP_HTTP_ADDR=:8080
ADMIN_PUBLIC_URL=https://admin.example.com
API_PUBLIC_URL=https://api.example.com

APP_MASTER_KEY=
JWT_SECRET=
JWT_EXPIRE_HOURS=168

ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=

DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=trademind
DB_PASSWORD=
DB_NAME=trademind
DB_TIMEZONE=UTC

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

LOG_LEVEL=info
UPLOAD_MAX_MB=10

# P5 observability / OTLP: endpoint and headers remain empty until a real telemetry backend is configured.
OBSERVABILITY_ENABLED=true
OBSERVABILITY_MODE=hybrid
OBSERVABILITY_ENVIRONMENT=production
LOG_FORMAT=json
METRICS_ENABLED=true
METRICS_INTERNAL_ONLY=true
TRACING_ENABLED=false
OTEL_SERVICE_NAME=trademind-api
OTEL_SERVICE_VERSION=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_TRACE_SAMPLE_RATIO=0.1
OTEL_EXPORT_TIMEOUT_SECONDS=10
OTEL_EXPORT_QUEUE_SIZE=1024
OTEL_EXPORT_BATCH_SIZE=128
OTEL_EXPORT_RETRY_MAX=2

# Production storage fail-fast（须与管理端 settings.storage.kind 一致；禁止 local）
STORAGE_PROVIDER=cos

# CORS 白名单（必填；与 ADMIN_PUBLIC_URL 域名一致，多域逗号分隔）
CORS_ALLOWED_ORIGINS=https://admin.example.com
CORS_ALLOW_CREDENTIALS=true

# 多实例滚动发布时串行迁移（PostgreSQL advisory lock）
MIGRATION_RUN_ON_STARTUP=true
MIGRATION_LOCK_TIMEOUT_SECONDS=120

# P6 backup / restore / release guardrails. Production must use private object storage or hybrid mode.
BACKUP_ENABLED=true
BACKUP_MODE=object_storage
BACKUP_SCHEDULE=0 3 * * *
BACKUP_STORAGE_PROVIDER=s3
BACKUP_STORAGE_BUCKET=
BACKUP_STORAGE_PREFIX=backups/production
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY_ID=app-master-key
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=12
BACKUP_MAX_AGE_HOURS=30
BACKUP_COMMAND_TIMEOUT_SECONDS=900
BACKUP_VERIFY_ENABLED=true
BACKUP_RESTORE_DRILL_ENABLED=false
BACKUP_RESTORE_DRILL_SCHEDULE=0 4 * * 0
POSTGRES_BACKUP_FORMAT=custom
POSTGRES_PG_DUMP_PATH=pg_dump
POSTGRES_PG_RESTORE_PATH=pg_restore
POSTGRES_PSQL_PATH=psql
POSTGRES_WAL_ARCHIVE_ENABLED=false
POSTGRES_WAL_ARCHIVE_PATH=
POSTGRES_PITR_ENABLED=false
RELEASE_ENABLED=false
RELEASE_ROOT=/opt/trademind/releases
RELEASE_ARTIFACT_DIR=artifacts/releases
RELEASE_CURRENT_LINK=/opt/trademind/releases/current
RELEASE_PREVIOUS_LINK=/opt/trademind/releases/previous
RELEASE_KEEP_COUNT=5
RELEASE_HEALTH_TIMEOUT_SECONDS=120
RELEASE_ROLLBACK_ON_FAILURE=true
RELEASE_REQUIRE_PRE_BACKUP=true
RELEASE_STRATEGY=blue_green
RELEASE_TRAFFIC_SWITCH_MODE=manual

ENABLE_SWAGGER=false
ENABLE_DEV_ROUTES=false
ENABLE_DEMO_SEED=false
ENABLE_DEBUG_ENDPOINTS=false

COLLECTOR_BASE_URL=http://127.0.0.1:3100
COLLECT_QUEUE_ENABLED=true
IMAGE_QUEUE_ENABLED=true
ORDER_SYNC_QUEUE_ENABLED=true
CUSTOMER_MESSAGE_SYNC_QUEUE_ENABLED=true
PRODUCT_PUBLISH_QUEUE_ENABLED=true
INVENTORY_SYNC_QUEUE_ENABLED=true

# Storage credentials: configure in Admin → 存储设置 (settings.storage), not here.
